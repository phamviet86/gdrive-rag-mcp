# Google Drive scope and durable index. Never commit a populated .env.
GDRIVE_FOLDER_ID=your_google_drive_folder_id
GDRIVE_RAG_INDEX_PROFILE=default
# Optional explicit override; profiles otherwise derive data/index-<profile>.db.
# GDRIVE_RAG_DB_PATH=./data/index.db

# Stdio or legacy single-token HTTP caller scope. Each ID grants the folder and
# all descendants. Defaults to GDRIVE_FOLDER_ID when omitted.
GDRIVE_RAG_PROFILE_ID=default
GDRIVE_RAG_ALLOWED_FOLDER_IDS=your_google_drive_folder_id

# Embedding provider: gemini (backward-compatible default), openai-compatible,
# or sentence-transformers (requires the optional package extra).
GDRIVE_RAG_EMBED_PROVIDER=gemini
GDRIVE_RAG_EMBED_MODEL=gemini-embedding-001
GDRIVE_RAG_EMBED_DIMENSIONS=768
GDRIVE_RAG_EMBED_API_KEY_ENV=GEMINI_API_KEY
GEMINI_API_KEY=your_gemini_api_key

# OpenAI-compatible example (uncomment and replace model/base URL as needed).
# GDRIVE_RAG_EMBED_PROVIDER=openai-compatible
# GDRIVE_RAG_EMBED_MODEL=text-embedding-3-small
# GDRIVE_RAG_EMBED_DIMENSIONS=1536
# GDRIVE_RAG_EMBED_BASE_URL=https://api.openai.com/v1
# GDRIVE_RAG_EMBED_API_KEY_ENV=OPENAI_API_KEY
# OPENAI_API_KEY=your_embedding_api_key
# GDRIVE_RAG_EMBED_SEND_DIMENSIONS=true

# OpenRouter Qwen3 Embedding 8B example (4096 is the full model dimension).
# GDRIVE_RAG_EMBED_PROVIDER=openai-compatible
# GDRIVE_RAG_EMBED_MODEL=qwen/qwen3-embedding-8b
# GDRIVE_RAG_EMBED_DIMENSIONS=4096
# GDRIVE_RAG_EMBED_BASE_URL=https://openrouter.ai/api/v1
# GDRIVE_RAG_EMBED_API_KEY_ENV=OPENROUTER_API_KEY
# OPENROUTER_API_KEY=your_embedding_api_key
# GDRIVE_RAG_EMBED_QUERY_INPUT_TYPE=search_query
# GDRIVE_RAG_EMBED_DOCUMENT_INPUT_TYPE=search_document

# Local Sentence Transformers example (no API key).
# GDRIVE_RAG_EMBED_PROVIDER=sentence-transformers
# GDRIVE_RAG_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# GDRIVE_RAG_EMBED_DIMENSIONS=384
# GDRIVE_RAG_EMBED_DEVICE=cpu

GDRIVE_RAG_EMBED_BATCH_SIZE=32
GDRIVE_RAG_EMBED_TIMEOUT_SECONDS=60
GDRIVE_RAG_CHUNK_SIZE=700
GDRIVE_RAG_CHUNK_OVERLAP=100
GDRIVE_RAG_EVIDENCE_THRESHOLD=0.35

# Choose ONE Google authentication method. Paths below are placeholders.
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/service-account.json
# GOOGLE_OAUTH_CLIENT_FILE=./secrets/oauth-client.json
# GOOGLE_OAUTH_TOKEN_FILE=./secrets/oauth-token.json
# GDRIVE_SHARED_DRIVE_ID=your_shared_drive_id

# Required for server mode. Use a long random value from your secret manager.
# For multiple profiles, use GDRIVE_RAG_ACCESS_POLICY_FILE instead and define
# each token environment variable named by that JSON file.
GDRIVE_RAG_BEARER_TOKEN=replace_with_a_long_random_secret
# GDRIVE_RAG_ACCESS_POLICY_FILE=./secrets/access-policy.json
GDRIVE_RAG_HOST=127.0.0.1
GDRIVE_RAG_PORT=8000
