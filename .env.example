# Google Drive scope and durable index. Never commit a populated .env.
GOOGLE_DRIVE_FOLDER_ID=your_google_drive_folder_id
GOOGLE_DRIVE_RAG_INDEX_PROFILE=default
# Optional explicit override; named index configurations derive data/index-<name>.db.
# GOOGLE_DRIVE_RAG_DB_PATH=./data/index.db

# Embedding provider: gemini (default), openai-compatible,
# or sentence-transformers (requires the optional package extra).
GOOGLE_DRIVE_RAG_EMBED_PROVIDER=gemini
GOOGLE_DRIVE_RAG_EMBED_MODEL=gemini-embedding-001
GOOGLE_DRIVE_RAG_EMBED_DIMENSIONS=768
GOOGLE_DRIVE_RAG_EMBED_API_KEY_ENV=GEMINI_API_KEY
GEMINI_API_KEY=your_gemini_api_key

# OpenAI-compatible example (uncomment and replace model/base URL as needed).
# GOOGLE_DRIVE_RAG_EMBED_PROVIDER=openai-compatible
# GOOGLE_DRIVE_RAG_EMBED_MODEL=text-embedding-3-small
# GOOGLE_DRIVE_RAG_EMBED_DIMENSIONS=1536
# GOOGLE_DRIVE_RAG_EMBED_BASE_URL=https://api.openai.com/v1
# GOOGLE_DRIVE_RAG_EMBED_API_KEY_ENV=OPENAI_API_KEY
# OPENAI_API_KEY=your_embedding_api_key
# GOOGLE_DRIVE_RAG_EMBED_SEND_DIMENSIONS=true

# OpenRouter Qwen3 Embedding 8B example (4096 is the full model dimension).
# GOOGLE_DRIVE_RAG_EMBED_PROVIDER=openai-compatible
# GOOGLE_DRIVE_RAG_EMBED_MODEL=qwen/qwen3-embedding-8b
# GOOGLE_DRIVE_RAG_EMBED_DIMENSIONS=4096
# GOOGLE_DRIVE_RAG_EMBED_BASE_URL=https://openrouter.ai/api/v1
# GOOGLE_DRIVE_RAG_EMBED_API_KEY_ENV=OPENROUTER_API_KEY
# OPENROUTER_API_KEY=your_embedding_api_key
# GOOGLE_DRIVE_RAG_EMBED_QUERY_INPUT_TYPE=search_query
# GOOGLE_DRIVE_RAG_EMBED_DOCUMENT_INPUT_TYPE=search_document

# Local Sentence Transformers example (no API key).
# GOOGLE_DRIVE_RAG_EMBED_PROVIDER=sentence-transformers
# GOOGLE_DRIVE_RAG_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# GOOGLE_DRIVE_RAG_EMBED_DIMENSIONS=384
# GOOGLE_DRIVE_RAG_EMBED_DEVICE=cpu

GOOGLE_DRIVE_RAG_EMBED_BATCH_SIZE=32
GOOGLE_DRIVE_RAG_EMBED_TIMEOUT_SECONDS=60
GOOGLE_DRIVE_RAG_CHUNK_SIZE=700
GOOGLE_DRIVE_RAG_CHUNK_OVERLAP=100
GOOGLE_DRIVE_RAG_EVIDENCE_THRESHOLD=0.35

# Authenticate with: google-drive-rag-mcp-auth --client-secret /path/to/client_secret.json
# The generated OAuth token defaults to ~/.config/google-drive-rag-mcp/token.json.
# GOOGLE_TOKEN_FILE=/absolute/path/to/.config/google-drive-rag-mcp/token.json
# GOOGLE_DRIVE_SHARED_DRIVE_ID=your_shared_drive_id
