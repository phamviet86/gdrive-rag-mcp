# Copy to .env only if your process manager loads it; never commit .env.
GDRIVE_FOLDER_ID=your_google_drive_folder_id
GEMINI_API_KEY=your_gemini_api_key
GDRIVE_RAG_DB_PATH=./data/index.db

# Choose ONE Google authentication method. Paths below are placeholders.
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/service-account.json
# GOOGLE_OAUTH_CLIENT_FILE=./secrets/oauth-client.json
# GOOGLE_OAUTH_TOKEN_FILE=./secrets/oauth-token.json

# Optional Shared Drive ID and tuning.
# GDRIVE_SHARED_DRIVE_ID=your_shared_drive_id
GDRIVE_RAG_EMBED_MODEL=gemini-embedding-001
GDRIVE_RAG_EMBED_DIMENSIONS=768
GDRIVE_RAG_CHUNK_SIZE=700
GDRIVE_RAG_CHUNK_OVERLAP=100
GDRIVE_RAG_EVIDENCE_THRESHOLD=0.35

# Required for server mode. Use a long random value from your secret manager.
GDRIVE_RAG_BEARER_TOKEN=replace_with_a_long_random_secret
GDRIVE_RAG_HOST=127.0.0.1
GDRIVE_RAG_PORT=8000
